{"schema": 1, "name": "ESP32 safety controller", "slug": "esp32-safety",
 "source": "Port of profiles/esp32_safety.json: nominal run, high-load PWM, fault while trigger HIGH must release the safety relay, recovery.",
 "requires": {"wiring": [{"pin": 17, "dir": "out", "dut": "GPIO4 trigger"}, {"pin": 18, "dir": "out", "dut": "GPIO5 PWM"},
                         {"pin": 27, "dir": "out", "dut": "GPIO18 fault"}, {"pin": 22, "dir": "in", "dut": "GPIO19 actuator"},
                         {"pin": 23, "dir": "in", "dut": "GPIO21 safety relay"}, {"pin": 14, "dir": "out", "dut": "GPIO16 RX2"},
                         {"pin": 15, "dir": "in", "dut": "GPIO17 TX2"}],
              "uart": [{"tx": 14, "rx": 15, "baud": 115200}], "scenario": "esp32_safety"},
 "steps": [
  {"id": "s1", "tool": "set_mode", "args": {"pin": 22, "mode": "input"}},
  {"id": "s2", "tool": "set_mode", "args": {"pin": 23, "mode": "input"}},
  {"id": "s3", "tool": "set_mode", "args": {"pin": 17, "mode": "output", "initial": 0}},
  {"id": "s4", "tool": "set_mode", "args": {"pin": 27, "mode": "output", "initial": 0}},
  {"id": "s5", "tool": "set_mode", "args": {"pin": 18, "mode": "pwm"}},
  {"id": "s6", "tool": "uart_open", "args": {"tx": 14, "rx": 15, "baud": 115200}},
  {"id": "s7", "tool": "uart_expect", "args": {"port": 0, "pattern": "BOOT OK", "timeout_ms": 2000}, "assert": true, "name": "Boot banner", "on_fail": "continue"},
  {"id": "s8", "tool": "assert_pin", "args": {"pin": 23, "level": 1, "name": "Idle: safety relay engaged"}, "assert": true, "on_fail": "continue"},
  {"id": "s9", "tool": "pwm", "args": {"pin": 18, "freq_hz": 100, "duty": 0.5}},
  {"id": "s10", "tool": "write", "args": {"pin": 17, "level": 1}},
  {"id": "s11", "tool": "assert_pin", "args": {"pin": 22, "level": 1, "name": "Nominal: actuator runs"}, "assert": true, "on_fail": "continue"},
  {"id": "s12", "tool": "pwm", "args": {"pin": 18, "freq_hz": 100, "duty": 0.9}},
  {"id": "s13", "tool": "assert_pin", "args": {"pin": 23, "level": 1, "name": "High load: relay still engaged"}, "assert": true, "on_fail": "continue"},
  {"id": "s14", "tool": "write", "args": {"pin": 27, "level": 1}},
  {"id": "s15", "tool": "assert_pin", "args": {"pin": 22, "level": 0, "name": "Fault while trigger HIGH: actuator stops"}, "assert": true, "on_fail": "continue"},
  {"id": "s16", "tool": "assert_pin", "args": {"pin": 23, "level": 0, "name": "Fault while trigger HIGH: safety relay released"}, "assert": true, "on_fail": "continue"},
  {"id": "s17", "tool": "uart_expect", "args": {"port": 0, "pattern": "state=FAULT.*safety=0", "timeout_ms": 500}, "assert": true, "name": "Telemetry claims safety=0", "on_fail": "continue"},
  {"id": "s18", "tool": "write", "args": {"pin": 17, "level": 0}},
  {"id": "s19", "tool": "write", "args": {"pin": 27, "level": 0}},
  {"id": "s20", "tool": "assert_pin", "args": {"pin": 23, "level": 1, "name": "Recovery: relay re-engaged"}, "assert": true, "on_fail": "continue"},
  {"id": "s21", "tool": "assert_pin", "args": {"pin": 22, "level": 0, "name": "Recovery: actuator idle"}, "assert": true, "on_fail": "continue"}
 ],
 "cleanup": [{"id": "c1", "tool": "release_all", "args": {}}]}
